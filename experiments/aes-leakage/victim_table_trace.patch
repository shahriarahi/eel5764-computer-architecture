+void
+RequestorPartitionManager::traceVictimFill(PacketPtr pkt, Addr blk_addr) const
+{
+    if (!pkt->req->hasVaddr()) {
+        victimMissingVaddrTotal++;
+        return;
+    }
+    const Addr vaddr = pkt->req->getVaddr();
+    if (vaddr < victimVaddrBase || vaddr >= victimVaddrBase + victimVaddrSize)
+        return;
+    if (curTick() == victimLastTick && blk_addr == victimLastBlock)
+        return;
+    victimLastTick = curTick();
+    victimLastBlock = blk_addr;
+
+    const unsigned line = (vaddr - victimVaddrBase) / blkSize;
+    const uint64_t set = (blk_addr / blkSize) % victimSetCount;
+    uint64_t &known = victimLineSetPlusOne[line];
+    if (known == 0)
+        known = set + 1;
+    else if (known != set + 1)
+        victimSetMismatchesTotal++;
+    stats.victimTableFills[line]++;
+    DPRINTF(VictimTable, "victim_fill line=%u set=%u vaddr=%#x paddr=%#x\n",
+        line, set, vaddr, blk_addr);
+}
